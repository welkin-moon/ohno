        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ohno"
            VALUE "FileDescription", "Ohno Classroom Assistant Installer"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "ohno-setup.exe"
            VALUE "OriginalFilename", "ohno-setup.exe"
            VALUE "ProductName", "Ohno Classroom Assistant"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
